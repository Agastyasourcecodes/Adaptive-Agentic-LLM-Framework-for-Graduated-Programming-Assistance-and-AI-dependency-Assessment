# Server
PORT=5000

# MongoDB — use your own connection string. NEVER commit real credentials.
MONGO_URI=mongodb+srv://windsgoslow_db_user:WzfpwvTn4jH73nZj@cluster0.ehpkphw.mongodb.net/adaptive_ai_coding_mentor

# ── Default model: Qwen via local Ollama (free, no key) ──────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:0.5b
OLLAMA_TIMEOUT_MS=120000

# ── Optional cloud models (add a key to enable it in the UI) ─────────────
# If a selected cloud model has no key, is rate-limited / out of quota,
# errors, or times out, the request automatically falls back to Qwen.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

XAI_API_KEY=
XAI_MODEL=grok-4.7

PROVIDER_TIMEOUT_MS=30000
# After a quota/auth failure the provider is skipped for this long
PROVIDER_COOLDOWN_SECONDS=60

# Scoring configuration
TIME_BENCHMARK_SECONDS=600
EVALUATION_WINDOW=10

# Single-student prototype mode (no auth) — identifies the demo student
DEMO_STUDENT_ID=demo-student-1
